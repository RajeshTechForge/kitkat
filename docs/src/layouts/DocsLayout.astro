---
import BaseLayout from "./BaseLayout.astro";
import DocsHeader from "../components/DocsHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DocsSidebar from "../components/DocsSidebar";
import type { NavGroup, SearchItem, DocPagination } from "../utils/docs";

interface Crumb {
    label: string;
    href?: string;
}
interface TocItem {
    label: string;
    href: string;
    depth?: number;
}
interface Props {
    title: string;
    description?: string;
    trail: Crumb[];
    toc?: TocItem[];
    navGroups?: NavGroup[];
    searchItems?: SearchItem[];
    pagination?: DocPagination;
}

const {
    title,
    description,
    trail,
    toc = [],
    navGroups = [],
    searchItems = [],
    pagination,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/docs";
---

<BaseLayout title={`${title} · Kitkat Docs`} description={description}>
    <div class="sticky top-0 z-30 bg-bg-primary">
        <DocsHeader searchItems={searchItems} />
        <Breadcrumbs trail={trail} />
    </div>

    <div
        class="grid-frame grid-cols-1 lg:grid-cols-[260px_1fr_240px] items-start min-h-[calc(100vh-5.75rem)]"
    >
        {/* Sidebar */}
        <aside
            id="docs-sidebar"
            class="pane pane-raised
             fixed inset-y-0 left-0 z-50 w-72 max-w-[80vw] -translate-x-full transition-transform duration-200 bg-bg-primary border-r border-border
             lg:sticky lg:top-23 lg:self-start lg:translate-x-0 lg:w-auto lg:max-w-none lg:max-h-[calc(100vh-5.75rem)] lg:overflow-y-auto lg:border-r-0 lg:z-10 no-scrollbar"
        >
            <div
                class="flex items-center justify-between px-5 py-3 border-b border-border lg:hidden"
            >
                <span class="eyebrow text-[11px]">Navigation</span>
                <button
                    id="docs-sidebar-close"
                    class="text-text-tertiary hover:text-text-primary p-1"
                    aria-label="Close navigation"
                >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        stroke="currentColor"
                        stroke-width="1.4"
                    >
                        <path d="M1 1L13 13M13 1L1 13"></path>
                    </svg>
                </button>
            </div>
            <DocsSidebar
                groups={navGroups}
                currentPath={currentPath}
                client:load
            />
        </aside>

        {/* Main Content Area */}
        <main class="pane p-5 sm:p-10 lg:p-14 min-w-0">
            <button
                id="docs-sidebar-open"
                class="btn btn-ghost lg:hidden inline-flex items-center gap-2 mb-6 text-[13px]"
            >
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    stroke="currentColor"
                    stroke-width="1.4"
                    fill="none"
                >
                    <path d="M1 3.5H13M1 7H13M1 10.5H13"></path>
                </svg>
                Menu
            </button>

            <article class="docs-prose max-w-[68ch] mx-auto lg:mx-0">
                <slot />
            </article>

            {/* Previous / Next Pagination Cards */}
            {
                pagination && (pagination.prev || pagination.next) && (
                    <div class="mt-14 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[68ch]">
                        {pagination.prev ? (
                            <a
                                href={pagination.prev.href}
                                class="pane p-4 flex flex-col gap-1 text-left hover:border-accent group transition-colors bg-bg-secondary/40 hover:bg-bg-tertiary"
                            >
                                <span class="eyebrow text-[10px] text-text-tertiary font-mono">
                                    ← Previous
                                </span>
                                <span class="text-[13.5px] font-medium text-text-primary group-hover:text-accent transition-colors">
                                    {pagination.prev.title}
                                </span>
                            </a>
                        ) : (
                            <div />
                        )}

                        {pagination.next ? (
                            <a
                                href={pagination.next.href}
                                class="pane p-4 flex flex-col gap-1 text-right hover:border-accent group transition-colors bg-bg-secondary/40 hover:bg-bg-tertiary sm:col-start-2"
                            >
                                <span class="eyebrow text-[10px] text-text-tertiary font-mono">
                                    Next →
                                </span>
                                <span class="text-[13.5px] font-medium text-text-primary group-hover:text-accent transition-colors">
                                    {pagination.next.title}
                                </span>
                            </a>
                        ) : (
                            <div />
                        )}
                    </div>
                )
            }
        </main>

        {/* Right TOC Sidebar */}
        <aside
            class="pane pane-raised p-6 hidden lg:block lg:sticky lg:top-23 lg:self-start lg:max-h-[calc(100vh-5.75rem)] lg:overflow-y-auto no-scrollbar"
        >
            <span class="eyebrow text-[11px]">On this page</span>
            {
                toc.length > 0 ? (
                    <ul id="docs-toc" class="mt-4 flex flex-col gap-2.5">
                        {toc.map((item) => (
                            <li class:list={[{ "pl-3": item.depth === 3 }]}>
                                <a
                                    href={item.href}
                                    class="text-[12.5px] text-text-secondary hover:text-accent transition-colors block py-0.5"
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p class="mt-4 text-[12px] text-text-tertiary font-mono">
                        no sections
                    </p>
                )
            }
        </aside>
    </div>

    {/* Mobile drawer background scrim */}
    <div
        class="fixed inset-0 z-40 bg-black/60 hidden transition-opacity duration-200"
        id="docs-sidebar-scrim"
    >
    </div>
</BaseLayout>

<script>
    const sidebar = document.getElementById("docs-sidebar");
    const scrim = document.getElementById("docs-sidebar-scrim");
    const openBtn = document.getElementById("docs-sidebar-open");
    const closeBtn = document.getElementById("docs-sidebar-close");

    function setOpen(open: boolean) {
        if (open) {
            sidebar?.classList.remove("-translate-x-full");
            sidebar?.classList.add("translate-x-0");
        } else {
            sidebar?.classList.remove("translate-x-0");
            sidebar?.classList.add("-translate-x-full");
        }
        scrim?.classList.toggle("hidden", !open);
        document.body.style.overflow = open ? "hidden" : "";
    }

    openBtn?.addEventListener("click", () => setOpen(true));
    closeBtn?.addEventListener("click", () => setOpen(false));
    scrim?.addEventListener("click", () => setOpen(false));

    sidebar?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
    });

    // ScrollSpy for TOC links
    const tocLinks =
        document.querySelectorAll<HTMLAnchorElement>("#docs-toc a");
    if (tocLinks.length > 0) {
        const headingIds = Array.from(tocLinks)
            .map((link) => link.getAttribute("href")?.replace("#", ""))
            .filter((id): id is string => Boolean(id));

        const headings = headingIds
            .map((id) => document.getElementById(id))
            .filter((el): el is HTMLElement => el !== null);

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute("id");
                        tocLinks.forEach((link) => {
                            const isMatch =
                                link.getAttribute("href") === `#${id}`;
                            link.classList.toggle("text-accent", isMatch);
                            link.classList.toggle("font-medium", isMatch);
                            link.classList.toggle(
                                "text-text-secondary",
                                !isMatch,
                            );
                        });
                    }
                });
            },
            { rootMargin: "-80px 0px -60% 0px", threshold: 0 },
        );

        headings.forEach((heading) => observer.observe(heading));
    }

    // Markdown-authored code fences wrapper script
    document
        .querySelectorAll<HTMLPreElement>(".docs-prose pre.astro-code")
        .forEach((pre) => {
            if (pre.closest(".code-frame")) return;

            const lang =
                pre.dataset.language ||
                pre.getAttribute("data-language") ||
                "code";

            const frame = document.createElement("div");
            frame.className =
                "grid-frame grid-rows-[auto_1fr] code-frame my-6 border border-border";

            const tabBar = document.createElement("div");
            tabBar.className =
                "pane pane-raised flex items-stretch h-10 border-b border-border bg-bg-secondary";
            tabBar.innerHTML = `
      <div class="tab flex items-center gap-2 px-4 border-r border-border text-[12px] font-mono text-text-primary bg-bg-tertiary">
        <span class="h-1.5 w-1.5 bg-accent"></span>${lang}
      </div>
      <div class="flex-1"></div>
      <button type="button" class="copy-btn tab flex items-center gap-1.5 px-4 text-[12px] font-mono text-text-tertiary hover:text-accent transition-colors" aria-label="Copy code">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="5" y="5" width="9" height="9"></rect><path d="M3 11V2h9"></path></svg>
        <span class="copy-label">copy</span>
      </button>`;

            const body = document.createElement("div");
            body.className = "pane p-4 overflow-x-auto text-[13px]";

            pre.parentElement?.insertBefore(frame, pre);
            frame.append(tabBar, body);
            body.append(pre);

            tabBar
                .querySelector(".copy-btn")
                ?.addEventListener("click", async () => {
                    await navigator.clipboard.writeText(pre.textContent ?? "");
                    const label = tabBar.querySelector(".copy-label");
                    if (label) {
                        const original = label.textContent;
                        label.textContent = "copied!";
                        setTimeout(() => (label.textContent = original), 1400);
                    }
                });
        });
</script>
