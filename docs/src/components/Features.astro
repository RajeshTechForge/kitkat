---
const features = [
    {
        tag: "providers",
        title: "Unified API Interface",
        body: "Swap providers (Anthropic, OpenAI, Google) by changing two lines. Requests, responses, and error handling stay identical across every provider.",
    },
    {
        tag: "routing",
        title: "Multi-Provider Router",
        body: "Pool providers with failover, least-latency, or round-robin strategies. Built-in circuit breakers isolate unhealthy APIs automatically.",
    },
    {
        tag: "streaming",
        title: "Async-First Streaming",
        body: "True async streaming across all providers. Every chunk is a typed StreamChunk, with final token usage and latency metrics included.",
    },
    {
        tag: "caching",
        title: "Response Caching & BYOK",
        body: "Built-in in-memory or Redis caching with deterministic SHA-256 hashing, plus per-request Bring Your Own Key support for multi-tenant apps.",
    },
];
---

<section
    id="features"
    class="grid-frame grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
>
    {
        features.map((f) => (
            <div class="pane p-8 lg:p-9 flex flex-col">
                <span class="eyebrow">{f.tag}</span>
                <h3 class="font-display text-xl mt-4 text-text-primary">
                    {f.title}
                </h3>
                <p class="mt-3 text-text-secondary text-[14px] leading-relaxed">
                    {f.body}
                </p>
            </div>
        ))
    }
</section>
