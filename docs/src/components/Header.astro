---
interface Props {
    active?: "home" | "docs";
}
const { active = "home" } = Astro.props;

const navLinks = [
    { label: "Docs", href: "/docs" },
    { label: "Features", href: "/#features" },
    { label: "Community", href: "https://github.com/RajeshTechForge/kitkat" },
];

const resources = [
    { label: "Releases", href: "/docs/changelog" },
    { label: "Changelog", href: "/docs/changelog" },
    { label: "About", href: "/docs" },
];
---

<header
    class="grid-frame grid-cols-[auto_1fr_auto] md:grid-cols-[auto_1fr_auto_auto_auto_auto_auto] h-14"
>
    <a href="/" class="pane flex items-center gap-2.5 px-4 sm:px-5">
        <img
            src="/logo.svg"
            alt="KitKat logo"
            width="18"
            height="18"
            class="shrink-0"
        />
        <span class="font-display font-bold text-[15px] tracking-wide"
            >KitKat</span
        >
    </a>

    <div class="pane"></div>

    {
        navLinks.map((link) => (
            <a
                href={link.href}
                class:list={[
                    "pane tab hidden md:flex items-center px-5 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors",
                    {
                        "text-text-primary bg-bg-secondary":
                            active === "docs" && link.label === "Docs",
                    },
                ]}
            >
                {link.label}
            </a>
        ))
    }

    <div class="pane relative group hidden md:block">
        <button
            class="tab flex items-center gap-1.5 px-5 h-full w-full text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
        >
            Resources
            <svg width="9" height="9" viewBox="0 0 9 9" class="mt-px">
                <path
                    d="M1 2.5L4.5 6.5L8 2.5"
                    stroke="currentColor"
                    stroke-width="1.2"
                    fill="none"></path>
            </svg>
        </button>
        <div
            class="grid-frame absolute right-0 top-full w-44 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-40"
        >
            {
                resources.map((r) => (
                    <a
                        href={r.href}
                        class="pane tab block px-4 py-3 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary"
                    >
                        {r.label}
                    </a>
                ))
            }
        </div>
    </div>

    <a
        href="https://github.com/RajeshTechForge/kitkat"
        class="pane btn btn-accent hidden md:flex items-center justify-center gap-2 px-5 border-0"
    >
        <img
            src="/github.svg"
            alt="GitHub logo"
            width="14"
            height="14"
            class="shrink-0"
        />
        Star on GitHub
    </a>

    {/* Mobile hamburger — no right border/gap needed */}

    <button
        id="header-mobile-open"
        class="pane md:hidden flex items-center justify-center w-14 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
        aria-label="Open menu"
    >
        <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
        >
            <path d="M2 4.5H16M2 9H16M2 13.5H16"></path>
        </svg>
    </button>
</header>

{/* Mobile menu drawer */}
<div
    id="header-mobile-drawer"
    class="fixed inset-y-0 right-0 z-50 w-72 max-w-[85vw] bg-bg-primary border-l border-border translate-x-full transition-transform duration-200 flex flex-col md:hidden"
>
    {/* Drawer header */}
    <div
        class="flex items-center justify-between px-5 py-3 border-b border-border"
    >
        <a href="/" class="flex items-center gap-2.5">
            <img
                src="/logo.svg"
                alt="KitKat logo"
                width="16"
                height="16"
                class="shrink-0"
            />
            <span class="font-display font-bold text-[14px] tracking-wide"
                >KitKat</span
            >
        </a>
        <button
            id="header-mobile-close"
            class="text-text-tertiary hover:text-text-primary p-1 transition-colors"
            aria-label="Close menu"
        >
            <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                stroke="currentColor"
                stroke-width="1.4"
            >
                <path d="M1 1L13 13M13 1L1 13"></path>
            </svg>
        </button>
    </div>

    {/* Nav links */}
    <nav class="flex flex-col py-2">
        {
            navLinks.map((link) => (
                <a
                    href={link.href}
                    class:list={[
                        "px-5 py-3.5 text-[14px] border-l-2 border-l-transparent hover:border-l-accent text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors font-mono",
                        {
                            "border-l-accent text-text-primary bg-bg-secondary":
                                active === "docs" && link.label === "Docs",
                        },
                    ]}
                >
                    {link.label}
                </a>
            ))
        }
    </nav>

    {/* Resources section */}
    <div class="border-t border-border">
        <p class="eyebrow text-[10px] px-5 pt-4 pb-2">Resources</p>
        {
            resources.map((r) => (
                <a
                    href={r.href}
                    class="block px-5 py-3 text-[13.5px] font-mono text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
                >
                    {r.label}
                </a>
            ))
        }
    </div>

    {/* GitHub CTA */}
    <div class="mt-auto p-5 border-t border-border">
        <a
            href="https://github.com/RajeshTechForge/kitkat"
            class="btn btn-accent flex items-center justify-center gap-2 w-full"
        >
            <img
                src="/github.svg"
                alt="GitHub"
                width="14"
                height="14"
                class="shrink-0"
            />
            Star on GitHub
        </a>
    </div>
</div>

{/* Scrim */}
<div
    id="header-mobile-scrim"
    class="fixed inset-0 z-40 bg-black/60 hidden md:hidden"
>
</div>

<script>
    const drawer = document.getElementById("header-mobile-drawer");
    const scrim = document.getElementById("header-mobile-scrim");
    const openBtn = document.getElementById("header-mobile-open");
    const closeBtn = document.getElementById("header-mobile-close");

    function setOpen(open: boolean) {
        if (open) {
            drawer?.classList.remove("translate-x-full");
            drawer?.classList.add("translate-x-0");
        } else {
            drawer?.classList.remove("translate-x-0");
            drawer?.classList.add("translate-x-full");
        }
        scrim?.classList.toggle("hidden", !open);
        document.body.style.overflow = open ? "hidden" : "";
    }

    openBtn?.addEventListener("click", () => setOpen(true));
    closeBtn?.addEventListener("click", () => setOpen(false));
    scrim?.addEventListener("click", () => setOpen(false));

    drawer?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
    });
</script>
