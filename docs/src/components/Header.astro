---
interface Props {
    active?: "home" | "docs";
}
const { active = "home" } = Astro.props;

const navLinks = [
    { label: "Docs", href: "/docs" },
    { label: "Features", href: "/#features" },
    { label: "Community", href: "https://github.com/RajeshTechForge/kitkat" },
];

const resources = [
    { label: "Releases", href: "/docs/changelog" },
    { label: "Changelog", href: "/docs/changelog" },
    { label: "About", href: "/docs" },
];
---

<header class="grid-frame grid-cols-[auto_1fr_auto_auto_auto_auto_auto] h-14">
    <a href="/" class="pane flex items-center gap-2.5 px-5">
        <img src="/logo.svg" alt="KitKat logo" width="18" height="18" class="shrink-0" />
        <span class="font-display font-bold text-[15px] tracking-wide"
            >KitKat</span
        >
    </a>

    <div class="pane"></div>

    {
        navLinks.map((link) => (
            <a
                href={link.href}
                class:list={[
                    "pane tab hidden md:flex items-center px-5 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors",
                    {
                        "text-text-primary bg-bg-secondary":
                            active === "docs" && link.label === "Docs",
                    },
                ]}
            >
                {link.label}
            </a>
        ))
    }

    <div class="pane relative group hidden md:block">
        <button
            class="tab flex items-center gap-1.5 px-5 h-full w-full text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
        >
            Resources
            <svg width="9" height="9" viewBox="0 0 9 9" class="mt-px">
                <path
                    d="M1 2.5L4.5 6.5L8 2.5"
                    stroke="currentColor"
                    stroke-width="1.2"
                    fill="none"></path>
            </svg>
        </button>
        <div
            class="grid-frame absolute right-0 top-full w-44 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-40"
        >
            {
                resources.map((r) => (
                    <a
                        href={r.href}
                        class="pane tab block px-4 py-3 text-text-secondary hover:text-text-primary hover:bg-bg-tertiary"
                    >
                        {r.label}
                    </a>
                ))
            }
        </div>
    </div>

    <a
        href="https://github.com/RajeshTechForge/kitkat"
        class="pane btn btn-accent flex items-center justify-center gap-2 px-5 border-0"
    >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
            <path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.44-2.51-.87-2.67-1.15-.16-.28-.85-1.15-1.45-1.4-.5-.27-1.19-.93-.02-.95.54-.02 1.15.36 1.36.83.79 1.34 2.06.96 2.57.73.08-.58.31-.96.57-1.19-1.99-.22-4.08-.99-4.08-4.42 0-.98.35-1.78.92-2.4-.09-.22-.4-1.13.09-2.36 0 0 .75-.24 2.47.91.71-.2 1.48-.3 2.24-.3.76 0 1.53.1 2.24.3 1.72-1.16 2.47-.91 2.47-.91.49 1.23.18 2.14.09 2.36.57.63.92 1.42.92 2.4 0 3.44-2.1 4.2-4.1 4.42.32.28.6.82.6 1.65l-.01 2.45c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
        </svg>
        <span class="hidden sm:inline">Star on GitHub</span>
        <span class="sm:hidden">GitHub</span>
    </a>
</header>
