---
const columns = [
    {
        heading: "Product",
        links: [
            { label: "Features", href: "/#features" },
            { label: "Installation", href: "/docs/installation" },
            { label: "Changelog", href: "/docs/changelog" },
            {
                label: "Roadmap",
                href: "https://github.com/RajeshTechForge/kitkat/blob/main/ROADMAP.md",
            },
        ],
    },
    {
        heading: "Docs",
        links: [
            { label: "Introduction", href: "/docs" },
            { label: "Core Concepts", href: "/docs/core-concepts" },
            { label: "API Reference", href: "/docs/api-reference" },
            { label: "Examples", href: "/docs/examples" },
        ],
    },
    {
        heading: "Community",
        links: [
            {
                label: "GitHub",
                href: "https://github.com/RajeshTechForge/kitkat",
            },
            {
                label: "Discussions",
                href: "https://github.com/RajeshTechForge/kitkat/discussions",
            },
            {
                label: "Issues",
                href: "https://github.com/RajeshTechForge/kitkat/issues",
            },
            { label: "Contributing", href: "/docs/contributing" },
        ],
    },
    {
        heading: "Resources",
        links: [
            { label: "PyPI Package", href: "https://pypi.org/project/kitkat" },
            { label: "License (MIT)", href: "/docs/changelog" },
            { label: "Security", href: "/docs/contributing" },
            { label: "About", href: "/docs" },
        ],
    },
];
---

<footer class="grid-frame grid-cols-1">
    <div class="grid-frame grid-cols-2 md:grid-cols-4">
        {
            columns.map((col) => (
                <div class="pane p-8">
                    <span class="eyebrow">{col.heading}</span>
                    <ul class="mt-4 flex flex-col gap-3">
                        {col.links.map((l) => (
                            <li>
                                <a
                                    href={l.href}
                                    class="text-[14px] text-text-secondary hover:text-accent transition-colors"
                                >
                                    {l.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    <div class="grid-frame grid-cols-[1fr_auto]">
        <div class="pane flex items-center gap-2.5 px-8 py-6">
            <svg width="14" height="14" viewBox="0 0 18 18" class="shrink-0">
                <rect x="0" y="0" width="8" height="8" fill="#f06b50"></rect>
                <rect x="10" y="0" width="8" height="8" fill="#5c5650"></rect>
                <rect x="0" y="10" width="8" height="8" fill="#5c5650"></rect>
                <rect x="10" y="10" width="8" height="8" fill="#f2ede8"></rect>
            </svg>
            <span class="font-mono text-[12.5px] text-text-tertiary">
                © {new Date().getFullYear()} Rajesh Mondal — released under the MIT
                license
            </span>
        </div>
        <div class="pane flex items-center gap-5 px-8">
            <a
                href="https://github.com/RajeshTechForge/kitkat"
                class="text-text-tertiary hover:text-accent transition-colors"
                aria-label="GitHub"
            >
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                >
                    <path
                        d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.44-2.51-.87-2.67-1.15-.16-.28-.85-1.15-1.45-1.4-.5-.27-1.19-.93-.02-.95.54-.02 1.15.36 1.36.83.79 1.34 2.06.96 2.57.73.08-.58.31-.96.57-1.19-1.99-.22-4.08-.99-4.08-4.42 0-.98.35-1.78.92-2.4-.09-.22-.4-1.13.09-2.36 0 0 .75-.24 2.47.91.71-.2 1.48-.3 2.24-.3.76 0 1.53.1 2.24.3 1.72-1.16 2.47-.91 2.47-.91.49 1.23.18 2.14.09 2.36.57.63.92 1.42.92 2.4 0 3.44-2.1 4.2-4.1 4.42.32.28.6.82.6 1.65l-.01 2.45c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                    ></path>
                </svg>
            </a>
            <span class="font-mono text-[11px] text-text-tertiary"
                >built with astro</span
            >
        </div>
    </div>
</footer>
