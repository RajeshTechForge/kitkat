---
interface Crumb {
    label: string;
    href?: string;
}
interface Props {
    trail: Crumb[];
}
const { trail } = Astro.props;
---

<div class="grid-frame grid-cols-1">
    <div class="pane flex items-center gap-2 px-5 h-9 font-mono text-[12px]">
        {
            trail.map((crumb, i) => (
                <>
                    {i > 0 && <span class="text-text-tertiary">/</span>}
                    {crumb.href ? (
                        <a
                            href={crumb.href}
                            class="text-text-tertiary hover:text-accent transition-colors"
                        >
                            {crumb.label}
                        </a>
                    ) : (
                        <span class="text-text-secondary">{crumb.label}</span>
                    )}
                </>
            ))
        }
    </div>
</div>
