---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
    getNavGroups,
    getSearchItems,
    getDocPagination,
} from "../../utils/docs";

export async function getStaticPaths() {
    const entries = await getCollection("docs");
    return entries.map((entry) => {
        let slug: string | undefined = entry.id;
        if (slug === "index") {
            slug = undefined;
        } else if (slug.endsWith("/index")) {
            slug = slug.slice(0, -6);
        }
        return {
            params: { slug },
            props: { entry },
        };
    });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const navGroups = await getNavGroups();
const searchItems = await getSearchItems();
const pagination = await getDocPagination(entry.id);

const toc = headings
    .filter((h) => h.depth === 2 || h.depth === 3)
    .map((h) => ({ label: h.text, href: `#${h.slug}`, depth: h.depth }));
---

<DocsLayout
    title={entry.data.title}
    description={entry.data.description}
    trail={[{ label: "Docs", href: "/docs" }, { label: entry.data.title }]}
    toc={toc}
    navGroups={navGroups}
    searchItems={searchItems}
    pagination={pagination}
>
    <h1>{entry.data.title}</h1>
    <Content />
</DocsLayout>
